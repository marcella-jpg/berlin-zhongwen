  "grammar": [
    {
      "title": "1. Subject + 要 + Verb (Want to / Going to)",
      "zh": "我要睡觉。",
      "py": "Wǒ yào shuìjiào.",
      "en": "I want to sleep / I am going to sleep."
    },
    {
      "title": "2. Subject + 在 / 正在 + Verb (Action in progress)",
      "zh": "他正在开车。",
      "py": "Tā zhèngzài kāichē.",
      "en": "He is currently driving."
    }
  ],
  "tips": [
    "Shadow it: play a word, pause, and repeat it right away. Copy the pitch, not just the sounds.",
    "Mind the tones: 读 (dú) rises like a question, while 睡觉 (shuìjiào) goes down then neutral/down.",
