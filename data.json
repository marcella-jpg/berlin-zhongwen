  "grammar": [
    {
      "title": "1. Word order is Subject + Verb + Object.",
      "zh": "我喝水。",
      "py": "Wǒ hē shuǐ.",
      "en": "I drink water."
    },
    {
      "title": "2. 想 + verb = “want to …”",
      "zh": "我想吃米饭。",
      "py": "Wǒ xiǎng chī mǐfàn.",
      "en": "I want to eat rice."
    },
    {
      "title": "3. Add 吗 to make a yes/no question.",
      "zh": "你喝茶吗？",
      "py": "Nǐ hē chá ma?",
      "en": "Do you drink tea?"
    }
  ],
  "tips": [
    "Shadow it: play a word, pause, and repeat it right away. Copy the pitch, not just the sounds.",
    "Mind the tones: 水 (shuǐ) dips down then up, and 茶 (chá) rises like a question.",
    "Go slow, then fast: say each sentence slowly three times, then at normal speed.",
